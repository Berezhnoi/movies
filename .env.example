# PostgreSQL connection settings
DB_HOST=db
DB_PORT=5432
DB_USER=movies
DB_PASSWORD=replace_with_a_local_password
DB_NAME=movies
DB_SSLMODE=disable
DATABASE_URL=postgres://movies:replace_with_a_local_password@db:5432/movies?sslmode=disable
TEST_DB_NAME=movies_test
TEST_DATABASE_URL=postgres://movies:replace_with_a_local_password@127.0.0.1:5432/movies_test?sslmode=disable
TEST_DATABASE_DOCKER_URL=postgres://movies:replace_with_a_local_password@db:5432/movies_test?sslmode=disable

# pgAdmin web UI (use a strong local password)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_local_pgadmin_password

# HTTP server settings
APP_PORT=8080
ALLOWED_ORIGIN=*
LOG_SQL=false
WEB_UI_ENABLED=true
# Comma-separated browser origins allowed to open the movie chat WebSocket.
WS_ALLOWED_ORIGINS=http://localhost:8080

# JWT signing secret (keep local; generate with: openssl rand -base64 48)
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_TTL=24h
# Must be true when serving the web UI behind HTTPS. Keep false for local http://localhost development.
COOKIE_SECURE=false

# First-admin seed credentials for `make seed-admin` (never used for public registration)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# PostgreSQL connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Optional user-created webhook (admin web registration). Empty WEBHOOK_URL disables it.
# Secret: at least 32 bytes, generate with: openssl rand -base64 48
WEBHOOK_URL=
WEBHOOK_SECRET=replace_with_a_random_webhook_secret_at_least_32_bytes
WEBHOOK_TIMEOUT=5s

# Movie trailers (optional, needs Floci S3). Keep TRAILERS_ENABLED=false to run without S3.
TRAILERS_ENABLED=false
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=trailers
# Dummy values for Floci only. Never put real AWS keys here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test