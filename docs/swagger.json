        }
    },
    "definitions": {
        "model.ErrorDetail": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "validation_error"
                },
                "message": {
                    "type": "string",
                    "example": "title is required"
                }
            }
        },
        "model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/model.ErrorDetail"
                }
            }
        },
        "model.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "model.LoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "model.MovieRequest": {
            "type": "object",
            "required": [
                "country",
                "director",
                "genre",
                "title"
            ],
            "properties": {
                "country": {
                    "type": "string",
                    "example": "United States"
                },
                "director": {
                    "type": "string",
                    "example": "Lana Wachowski"
                },
                "genre": {
                    "type": "string",
                    "example": "Science Fiction"
                },
                "release_year": {
                    "description": "ReleaseYear may be omitted or set to null.",
                    "type": "integer",
                    "example": 1999
                },
                "synopsis": {
                    "description": "Synopsis may be omitted or set to null; an empty string is valid.",
                    "type": "string",
                    "example": "A computer hacker learns about reality."
                },
                "title": {
                    "type": "string",
                    "example": "The Matrix"
                }
            }
        },
        "model.MovieResponse": {
            "type": "object",
            "properties": {
                "country": {
                    "type": "string",
                    "example": "United States"
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-10-05T12:00:00.123456Z"
                },
                "director": {
                    "type": "string",
